e 1.44: The double pendulum", :description "This namespace explores Exercise 1.44 from Sussman and Wisdom's Structure and Interpretation of Classical Mechanics, using the Emmy Clojure library and the Clerk rendering environment."}, :title "Exercise 1.44: The double pendulum", :blocks [{:path [], :nextjournal/value [:div.viewer.markdown-viewer.w-full.max-w-prose.px-8 {:data-block-id "user/markdown-5dt3g2RcGEqkxmEkVsQUPTBvxG1NEt"} ["h1" {:id "exercise-1.44:-the-double-pendulum"} [:<> "Exercise 1.44: The double pendulum"]] [:p [:<> "This namespace explores "] [:a {:href "https://tgvaughan.github.io/sicm/chapter001.html#Exe_1-44"} [:<> "Exercise"] [#viewer-eval nextjournal.clerk.render/inspect-presented {:nextjournal/value [:<> " "], :nextjournal/viewer {:name nextjournal.clerk.viewer/html-viewer, :render-fn #viewer-fn nextjournal.clerk.render/render-html, :hash "5drpr3yzJ1CcHNbRHnK2sVyn7YUmXB"}}] [:<> "1.44"]] [:<> " from Sussman"] [#viewer-eval nextjournal.clerk.render/inspect-presented {:nextjournal/value [:<> " "], :nextjournal/viewer {:name nextjournal.clerk.viewer/html-viewer, :render-fn #viewer-fn nextjournal.clerk.render/render-html, :hash "5drpr3yzJ1CcHNbRHnK2sVyn7YUmXB"}}] [:<> "and Wisdom's "] [:a {:href "https://tgvaughan.github.io/sicm/"} [:<> "Structure and Interpretation of Classical"] [#viewer-eval nextjournal.clerk.render/inspect-presented {:nextjournal/value [:<> " "], :nextjournal/viewer {:name nextjournal.clerk.viewer/html-viewer, :render-fn #viewer-fn nextjournal.clerk.render/render-html, :hash "5drpr3yzJ1CcHNbRHnK2sVyn7YUmXB"}}] [:<> "Mechanics"]] [:<> ", using"] [#viewer-eval nextjournal.clerk.render/inspect-presented {:nextjournal/value [:<> " "], :nextjournal/viewer {:name nextjournal.clerk.viewer/html-viewer, :render-fn #viewer-fn nextjournal.clerk.render/render-html, :hash "5drpr3yzJ1CcHNbRHnK2sVyn7YUmXB"}}] [:<> "the "] [:a {:href "https://github.com/emmy/emmy"} [:<> "Emmy"]] [:<> " Clojure library and"] [#viewer-eval nextjournal.clerk.render